#!/usr/bin/env php
<?php

declare(strict_types=1);

use Shikiphp\Highlighter;
use Shikiphp\Shikiphp;

(static function (): void {
    foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
        if (is_file($autoload)) {
            require_once $autoload;

            return;
        }
    }

    fwrite(STDERR, "Could not locate the Composer autoloader. Run `composer install`.\n");
    exit(1);
})();

$argv = $_SERVER['argv'];
$command = $argv[1] ?? null;

if ($command === null || in_array($command, ['-h', '--help', 'help'], true)) {
    echo <<<TXT
    shikiphp — pure PHP syntax highlighter (a Shiki port)

    Usage:
      shikiphp highlight <file|-> [--lang=<lang>] [--theme=<theme>] [--format=html|ansi] [--color-level=0..3]
      shikiphp langs                                                List bundled languages
      shikiphp themes                                               List bundled themes

    TXT;
    exit(0);
}

try {
    match ($command) {
        'highlight' => cmdHighlight($argv),
        'langs' => cmdLangs(),
        'themes' => cmdThemes(),
        default => throw new RuntimeException("Unknown command: {$command}"),
    };
} catch (Throwable $error) {
    fwrite(STDERR, $error->getMessage() . "\n");
    exit(1);
}

function cmdHighlight(array $argv): void
{
    $file = null;
    $lang = null;
    $theme = 'github-dark';
    $format = 'html';
    $colorLevel = 3;

    foreach (array_slice($argv, 2) as $arg) {
        if (str_starts_with($arg, '--lang=')) {
            $lang = substr($arg, 7);
        } elseif (str_starts_with($arg, '--theme=')) {
            $theme = substr($arg, 8);
        } elseif (str_starts_with($arg, '--format=')) {
            $format = substr($arg, 9);
        } elseif (str_starts_with($arg, '--color-level=')) {
            $value = substr($arg, 14);
            if (!in_array($value, ['0', '1', '2', '3'], true)) {
                throw new RuntimeException('ANSI colorLevel must be between 0 and 3.');
            }
            $colorLevel = (int) $value;
        } elseif (!str_starts_with($arg, '--')) {
            $file = $arg;
        }
    }

    if ($file === null || ($file !== '-' && !is_file($file))) {
        throw new RuntimeException('Usage: shikiphp highlight <file|-> [--lang=<lang>] [--theme=<theme>] [--format=html|ansi] [--color-level=0..3]');
    }
    if (!in_array($format, ['html', 'ansi'], true)) {
        throw new RuntimeException('Unknown format: ' . $format);
    }

    $code = (string) file_get_contents($file === '-' ? 'php://stdin' : $file);
    $lang = strtolower($lang ?? pathinfo($file, PATHINFO_EXTENSION));
    if (!in_array($lang, [...Highlighter::createBundled()->loadedLanguages(), 'text', 'txt', 'plain', 'plaintext', 'ansi'], true)) {
        $lang = 'text';
    }
    $options = ['lang' => $lang, 'theme' => $theme];
    echo $format === 'ansi'
        ? Shikiphp::codeToANSI($code, $options, $colorLevel)
        : Shikiphp::codeToHtml($code, $options) . "\n";
}

function cmdLangs(): void
{
    foreach (Highlighter::createBundled()->loadedLanguages() as $lang) {
        echo $lang, "\n";
    }
}

function cmdThemes(): void
{
    foreach (Highlighter::createBundled()->loadedThemes() as $theme) {
        echo $theme, "\n";
    }
}
